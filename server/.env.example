# Copy to server/.env (git-ignored) and fill in. Never commit the real file.
# On Render, set these in the service's Environment settings instead.

# Required. Server-side only: the browser never sees this key.
ANTHROPIC_API_KEY=

# Browser origins allowed to call the API (CORS), comma-separated, no trailing slash.
# Production: your Vercel site, e.g. https://your-site.vercel.app
# ALLOWED_ORIGINS=http://localhost:5179,http://127.0.0.1:5179

# Optional (defaults shown)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=medium          # low | medium | high | xhigh | max
# ANTHROPIC_FALLBACKS=default      # server-side refusal fallback; set to off for models without it
# DAILY_BUDGET_USD=5               # estimated spend per UTC day before /api/select refuses; 0 = no cap

# HOST=0.0.0.0                     # default: all interfaces (needed on Render). Use 127.0.0.1 to keep it on this machine
# PORT=5179                        # Render and similar hosts set PORT themselves
# STATIC_DIR=../app                # serves the frontend from the same origin; empty to disable

# Request limits
# MAX_BODY_BYTES=8388608           # 8 MB per request
# MAX_IMAGE_BYTES=524288           # 512 KB per image (decoded)
# MAX_IMAGE_SIDE=1024              # longest side, pixels
# MAX_REFERENCES=3                 # past posts per request
# MAX_CANDIDATES=40                # shoot frames per request (all sent to Claude together)
# RATE_LIMIT_PER_MINUTE=20         # per client address
# MAX_CONCURRENT=2                 # Claude calls in flight
# REQUEST_TIMEOUT_MS=180000
